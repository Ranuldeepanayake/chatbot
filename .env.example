# Application
PORT=4000
HOST_PORT=4000

# Choose the default provider: bedrock or ollama
AI_PROVIDER=bedrock

# Bedrock-compatible endpoint and bearer token
POST_REQUEST_URL=https://bedrock-mantle.ap-southeast-1.api.aws/v1
ACCESS_TOKEN=replace-with-your-access-token

# Ollama (no access token required). The Ollama server must be reachable by the app.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
