# Application
PORT=4000
HOST_PORT=4000

# Choose the default provider: bedrock or ollama
AI_PROVIDER=bedrock

# Bedrock Converse endpoint and bearer token
BEDROCK_URL=https://bedrock-runtime.ap-southeast-1.amazonaws.com
# Choose one: global.openai.gpt-6-luna or global.anthropic.claude-haiku-5-5
BEDROCK_MODEL=global.openai.gpt-6-luna
ACCESS_TOKEN=replace-with-your-access-token

# Ollama OpenAI-compatible endpoint (no access token required).
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
