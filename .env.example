# Application
PORT=4000
HOST_PORT=4000
# Optional public origin used by dynamically generated sitemap.xml and robots.txt.
# PUBLIC_BASE_URL=https://chat.example.com
# Maximum assistant text returned to the browser. Larger responses are truncated safely.
MAX_RESPONSE_CHARS=200000

# Choose the default provider: bedrock, openai, or ollama
AI_PROVIDER=bedrock

# Bedrock Converse endpoint and bearer token
BEDROCK_URL=https://bedrock-runtime.us-east-1.amazonaws.com
# Choose one: global.openai.gpt-6-luna, global.anthropic.claude-haiku-5-5,
# or global.amazon.nova-2-lite-v1:0
BEDROCK_MODEL=global.amazon.nova-2-lite-v1:0
ACCESS_TOKEN=replace-with-your-access-token

# Ollama OpenAI-compatible endpoint (no access token required).
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# OpenAI Responses API
OPENAI_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=replace-with-your-openai-api-key
